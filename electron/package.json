{
  "name": "codebot",
  "version": "6.0.0",
  "description": "基于 OpenCode 的个人 AI 助手",
  "author": "Codebot",
  "main": "main.js",
  "scripts": {
    "start": "chcp 65001 && electron .",
    "build": "electron-builder",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ai.codebot.app",
    "productName": "Codebot",
    "directories": {
      "output": "dist/electron_new"
    },
    "files": [
      "main.js",
      "preload.js",
      "docker-installer.js",
      "rakazo-startup.js",
      "loading.html"
    ],
    "extraResources": [
      {
        "from": "../backend/dist_build/codebot-backend",
        "to": "backend/codebot-backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend-dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../README.md",
        "to": "README.md"
      },
      {
        "from": "../skills",
        "to": "skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../integrations",
        "to": "integrations",
        "filter": [
          "rakazo/**/*",
          "rakazo-adapter/package.json",
          "rakazo-adapter/package-lock.json",
          "rakazo-adapter/tsconfig.json",
          "rakazo-adapter/Dockerfile",
          "rakazo-adapter/src/**/*"
        ]
      },
      {
        "from": "vendor/opencode",
        "to": "opencode",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "zip"
      ]
    },
    "win": {
      "icon": "../logo.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Codebot-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "selectPerMachineByDefault": false
    },
    "portable": {
      "artifactName": "Codebot-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "Codebot-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yuhanbo758",
        "repo": "codebot"
      }
    ]
  }
}
